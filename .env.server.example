# ===== Настройки для сервера =====
# Скопируйте:  cp .env.server.example .env   и заполните.

# Длинная случайная строка. Сгенерировать:  openssl rand -base64 48
SECRET_KEY=

# --- Вариант А: есть домен (рекомендуется) ---
# DNS-запись типа A для домена должна указывать на IP сервера.
DOMAIN=helpdesk.example.ru
SITE_URL=https://helpdesk.example.ru
ALLOWED_HOSTS=helpdesk.example.ru
CSRF_TRUSTED_ORIGINS=https://helpdesk.example.ru
HTTPS=True

# --- Вариант Б: только IP-адрес, без HTTPS (для проверки) ---
# DOMAIN=:80
# SITE_URL=http://203.0.113.10
# ALLOWED_HOSTS=203.0.113.10
# CSRF_TRUSTED_ORIGINS=http://203.0.113.10
# HTTPS=False

# --- База данных PostgreSQL (создаётся автоматически) ---
POSTGRES_DB=servicedesk
POSTGRES_USER=servicedesk
# Сгенерировать:  openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Почта для уведомлений (необязательно) ---
# Пока EMAIL_HOST пустой, письма не отправляются, а печатаются в консоль.
# Яндекс: smtp.yandex.ru, порт 465, нужен «пароль приложения» (id.yandex.ru → Безопасность → Пароли приложений)
# Mail.ru: smtp.mail.ru, порт 465, тоже «пароль для внешнего приложения»
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=ServiceDesk ПМ <helpdesk@yandex.ru>

# --- Боты: какие запускать (vk, max, vk,max или пусто) ---
COMPOSE_PROFILES=
VK_TOKEN=
VK_GROUP_ID=
MAX_TOKEN=
MAX_API_URL=https://platform-api.max.ru
