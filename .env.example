# Скопируйте этот файл в .env и заполните.
SECRET_KEY=замените-на-длинную-случайную-строку
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# Адрес сайта — используется в ссылках, которые присылает бот
SITE_URL=http://127.0.0.1:8000

# --- Бот ВКонтакте (ключ доступа сообщества и его ID) ---
VK_TOKEN=
VK_GROUP_ID=

# --- Бот MAX ---
MAX_TOKEN=
MAX_API_URL=https://platform-api.max.ru

# --- Почта для уведомлений (необязательно) ---
# Пока EMAIL_HOST пустой, письма не отправляются, а печатаются в консоль.
# Яндекс: smtp.yandex.ru, порт 465, нужен «пароль приложения» (id.yandex.ru → Безопасность → Пароли приложений)
# Mail.ru: smtp.mail.ru, порт 465, тоже «пароль для внешнего приложения»
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=ServiceDesk ПМ <helpdesk@yandex.ru>

# --- База данных: sqlite (по умолчанию) или postgres ---
DB_ENGINE=sqlite
# DB_NAME=servicedesk
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
